# Copy to .env and replace every change-me value.
# Generate random values with: python -c "import secrets; print(secrets.token_urlsafe(24))"

# PostgreSQL admin user, and one login per service database.
# Applied when the database volume is first created; to change them later run `docker compose down -v`.
POSTGRES_PASSWORD=change-me
DOCTOR_DB_PASSWORD=change-me
PATIENT_DB_PASSWORD=change-me
APPOINTMENT_DB_PASSWORD=change-me

# Signs and verifies staff session tokens (shared by auth, patient and appointment services).
JWT_SECRET=change-me

# Front-desk staff sign-in.
STAFF_EMAIL=frontdesk@medibook.test
STAFF_NAME=Front desk
STAFF_ROLE=Receptionist
STAFF_PASSWORD=change-me

APP_VERSION=1.0.0
