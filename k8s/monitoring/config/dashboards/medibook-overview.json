          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(http_request_duration_highr_seconds_count{namespace=\"medibook\"}, service)",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
